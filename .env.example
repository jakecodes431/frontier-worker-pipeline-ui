# Frontier + Worker Pipeline & UI - example environment
#
# Copy to .env (git-ignored) and edit. The server does NOT load .env by itself:
# export these in your shell, or start it with a loader, e.g.
#   node --env-file=.env server/index.js
# Every variable below is optional; the defaults in config/runtimes.json work
# unchanged on macOS, Linux and Windows. Never commit real keys.
#
# Requires Node >= 22.13 (node:sqlite must be available without a flag).


# ---------------------------------------------------------------------------
# Control room server
# ---------------------------------------------------------------------------

# Port the HTTP + WebSocket server listens on.
# Default: the "port" value in config/runtimes.json (4800).
#CR_PORT=4800

# Interface to bind. Keep the loopback address: this tool spawns real processes
# on your machine and has no authentication of any kind. Do not expose it.
# Default: the "host" value in config/runtimes.json (127.0.0.1).
#CR_HOST=127.0.0.1

# Where the SQLite database, per-agent briefs and terminal scrollback are kept.
# Relative paths resolve against the repository root; ~ and ${VARS} are expanded.
# Default: the "dataDir" value in config/runtimes.json (./data).
#CR_DATA_DIR=./data

# Directory holding your own runtimes.json / pricing.json / protocol.md, so you
# can keep local settings outside the checkout. Any file missing there falls
# back to the repository's config/ directory.
# Default: unset (use config/).
#CR_CONFIG_DIR=~/.config/frontier-worker-pipeline-ui


# ---------------------------------------------------------------------------
# Clients (bin/cr.js and scripts/*.mjs)
# ---------------------------------------------------------------------------

# Base URL of a running control room, used by bin/cr.js and the launch scripts.
# The server sets this automatically inside every agent it spawns.
# Default: http://127.0.0.1:4800
#CR_URL=http://127.0.0.1:4800

# Identity of the calling agent for bin/cr.js. The server sets it inside each
# spawned terminal; leave it unset when you run the CLI yourself, so your
# commands count as coming from a human.
#CR_AGENT_ID=


# ---------------------------------------------------------------------------
# Frontier runtime: Claude Code CLI ("claude" runtime)
# ---------------------------------------------------------------------------

# Where the Claude Code CLI keeps its state. The control room reads session
# transcripts from <CLAUDE_CONFIG_DIR>/projects/ to show usage, cost and chat,
# so set this only if you have already moved the CLI's config directory.
# Default: ~/.claude
#CLAUDE_CONFIG_DIR=~/.claude

# Authentication is entirely the CLI's own: sign in once with `claude` in a
# terminal, or set the CLI's documented API-key variable in your shell. The
# control room never reads, stores or forwards frontier credentials.


# ---------------------------------------------------------------------------
# Worker runtime: DeepSeek Harness ("deepseek" runtime)
# ---------------------------------------------------------------------------

# Your DeepSeek Harness checkout. config/runtimes.json launches
# ${DSH_REPO}/apps/cli/lib/bin.js with node.
# Default: ~/deepseek-harness
#DSH_REPO=~/deepseek-harness

# Harness state directory: settings plus the session records the control room
# reads worker token usage from.
# Default: ~/.dsh
#DSH_HOME=~/.dsh

# API key for the worker model. Put the real value in your shell or .env only -
# never in this file and never in config/*.json.
# It is the one *_KEY / *_TOKEN / *_SECRET variable forwarded to worker
# processes (see "scrubEnvContaining" / "keepEnv" in config/runtimes.json);
# every other secret in your environment is stripped before a worker starts.
#DEEPSEEK_API_KEY=


# ---------------------------------------------------------------------------
# Project gate (npm run check)
# ---------------------------------------------------------------------------

# Port the offline smoke test boots its scratch server on. By default it asks
# the OS for a free one, so the gate never collides with whatever you are
# running. Pin it only if you need a predictable port.
#CR_SMOKE_PORT=4899
